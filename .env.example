# Crosscast Configuration

# Inbound HTTP Gateway Port (Default: 6403)
PORT=6403

# Secret API key for authenticating incoming broadcast requests (Bearer token)
# If left empty, Crosscast will allow unauthenticated local requests.
CROSSCAST_API_KEY=secret_crosscast_api_token_here

# Discord Bot Credentials
# Get these from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_APP_ID=your_discord_application_id_here

# Optional: Specific Discord Guild ID for instant slash command registration (empty = global)
DISCORD_GUILD_ID=

# Default Channel ID (fallback when payload target is "default" or omitted)
DISCORD_DEFAULT_CHANNEL_ID=

# Custom Channel Routing Map (Target Name -> Discord Channel Snowflake ID as JSON)
CROSSCAST_CHANNELS={"alerts":"123456789012345678","announcements":"123456789012345678","deployments":"123456789012345678"}

# Discord Bot Presence Custom Status
CROSSCAST_STATUS_MESSAGE=Broadcasting with Crosscast 📡

# Telegram Gateway (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
