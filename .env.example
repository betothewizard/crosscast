# Crosscast Configuration

# Inbound HTTP Gateway Port (Default: 6403)
PORT=6403

# Secret API key for authenticating incoming broadcast requests (Bearer token)
# If left empty, Crosscast will allow unauthenticated local requests.
CROSSCAST_API_KEY=secret_crosscast_api_token_here

# Discord Bot Credentials
# Get these from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_APP_ID=your_discord_application_id_here
DISCORD_GUILD_ID=
DISCORD_DEFAULT_CHANNEL_ID=

# Telegram Bot Credentials
# Create a bot via @BotFather on Telegram to obtain your token
TELEGRAM_BOT_TOKEN=
# Fallback chat ID / channel (e.g. -1001234567890 or @channel_username)
TELEGRAM_CHAT_ID=

# Custom Channel Routing Map (JSON object string)
# Supports mapping to Discord, Telegram, or simultaneously to BOTH platforms:
#
# Format A (Multi-platform broadcast to both Discord & Telegram):
# CROSSCAST_CHANNELS={"jobs":{"discord":"123456789012345678","telegram":"-1001234567890"}}
#
# Format B (Single platform per target):
CROSSCAST_CHANNELS={"alerts":"123456789012345678","tg_alerts":"-1001234567890"}

# Bot Presence Custom Status
CROSSCAST_STATUS_MESSAGE=Broadcasting with Crosscast 📡
